---
import '../styles/global.css';
import { ViewTransitions } from 'astro:transitions';
import { siteConfig } from '../data/site';

interface Props {
  title?: string;
  description?: string;
  canonical?: string;
  type?: string;
  image?: string;
  jsonLd?: string;
}

const {
  title = siteConfig.title,
  description = siteConfig.description,
  canonical = siteConfig.url + '/',
  type = 'website',
  image = siteConfig.image,
  jsonLd = '',
} = Astro.props;

const fullTitle = title === siteConfig.title ? title : `${title} — Shahid Hocien`;
---

<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <meta name="description" content={description} />
  <meta name="author" content="Shahid Hocien" />
  <meta property="og:site_name" content="Shahid Hocien" />
  <meta property="og:locale" content="en_US" />
  <meta property="og:title" content={fullTitle} />
  <meta property="og:description" content={description} />
  <meta property="og:type" content={type} />
  <meta property="og:url" content={canonical} />
  <meta property="og:image" content={siteConfig.url + image} />
  <meta property="og:image:alt" content={fullTitle} />
  <meta property="og:image:width" content="400" />
  <meta property="og:image:height" content="400" />
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:site" content="@shahidhocien" />
  <meta name="twitter:creator" content="@shahidhocien" />
  <meta name="twitter:title" content={fullTitle} />
  <meta name="twitter:description" content={description} />
  <meta name="twitter:image" content={siteConfig.url + image} />
  <meta name="twitter:image:alt" content={fullTitle} />
  <link rel="canonical" href={canonical} />
  <link rel="icon" type="image/svg+xml" href="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 32 32'%3E%3Crect width='32' height='32' rx='4' fill='%23000'/%3E%3Ccircle cx='16' cy='16' r='6' fill='none' stroke='%237fd8ff' stroke-width='1.5'/%3E%3C/svg%3E" />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Italiana&family=Outfit:wght@300;400;600&display=swap" />
  <script is:inline defer src="/js/main.js"></script>
  <ViewTransitions />
  <title>{fullTitle}</title>
  {jsonLd && <script type="application/ld+json" set:html={jsonLd} />}
  <slot name="head" />
</head>
<body class:list={[Astro.props.bodyClass ?? '']}>
  <noscript>
    <div style="position:fixed;top:0;left:0;width:100%;padding:20px;background:#111;color:#eee;text-align:center;z-index:99999;font-family:sans-serif;">
      ⚡ Please enable JavaScript for the full experience. Your browser does not support JavaScript or it is disabled.
    </div>
  </noscript>
  <a href="#main-content" class="skip-to-content">Skip to main content</a>
  <div class="cursor-inner" role="presentation" aria-hidden="true"></div>
  <div class="cursor-outer" role="presentation" aria-hidden="true"></div>
  <slot />
</body>
</html>