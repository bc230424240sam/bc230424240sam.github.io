// Three.js 3D background — bundled locally via Astro (no CDN).
// Try-catch around init() ensures animate() always runs (slides work even without 3D).
---

<div id="loading" role="status" aria-live="polite">
  <span>Loading model...</span>
  <div class="load-bar"><div class="load-bar-fill"></div></div>
</div>

<canvas id="webgl" role="img" aria-label="Interactive 3D background scene"></canvas>

<script>
  import {
    Scene, Color, FogExp2, PerspectiveCamera, WebGLRenderer,
    PCFSoftShadowMap, ACESFilmicToneMapping, AmbientLight, SpotLight,
    DirectionalLight, HemisphereLight, Vector2, Vector3, CanvasTexture,
    ShaderMaterial, PlaneGeometry, BufferGeometry, BufferAttribute,
    PointsMaterial, AdditiveBlending, Points, CubeTexture, Group, Box3,
    CircleGeometry, MeshPhysicalMaterial, DoubleSide, RingGeometry,
    MeshBasicMaterial, Mesh, Quaternion, Matrix4, Clock
  } from 'three';
  import { GLTFLoader } from 'three/addons/loaders/GLTFLoader.js';
  import { DRACOLoader } from 'three/addons/loaders/DRACOLoader.js';

  console.log('[ThreeScene] Module loaded, DOM ready:', document.readyState);

let canvas = null;

let scene, camera, renderer;
let modelPivot;
let headBone = null;
let started = false;

const clock = new Clock();
let currentScroll = 0;
let currentSlide = 0;
let blockScroll = false;
const slideTargets = [0.0, 0.34, 0.62, 0.94];

let mouseX = 0, mouseY = 0, targetMouseX = 0, targetMouseY = 0;
let cursorX = window.innerWidth / 2, cursorY = window.innerHeight / 2;
let outerCursorX = window.innerWidth / 2, outerCursorY = window.innerHeight / 2;

let bgMaterial;
const shaderUniforms = {
    uTime: { value: 0 },
    uResolution: { value: new Vector2(window.innerWidth, window.innerHeight) },
    uMouse: { value: new Vector2(0, 0) },
    uScroll: { value: 0 }
};

let sparkParticles;
const sparkCount = (window.__PERF_CONFIG__ && window.__PERF_CONFIG__.sparkCount) ? window.__PERF_CONFIG__.sparkCount : 200;
const sparkData = [];

const sizes = { width: window.innerWidth, height: window.innerHeight };

function getPixelRatio() {
    const perfRatio = (window.__PERF_CONFIG__ && window.__PERF_CONFIG__.pixelRatio) || window.devicePixelRatio;
    return Math.min(perfRatio, 1.5);
}

let disposed = false;
let rafId = null;

function disposeThree() {
    if (disposed) return;
    disposed = true;
    started = false;
    if (rafId !== null) {
        cancelAnimationFrame(rafId);
        rafId = null;
    }
    sparkData.length = 0;
    try {
        if (scene) {
            scene.traverse((obj) => {
                if (obj.geometry) obj.geometry.dispose();
                if (obj.material) {
                    const mats = Array.isArray(obj.material) ? obj.material : [obj.material];
                    mats.forEach((m) => {
                        if (m.map) m.map.dispose();
                        m.dispose();
                    });
                }
            });
            if (scene.environment) scene.environment.dispose();
        }
        if (renderer) {
            renderer.dispose();
            renderer.forceContextLoss();
        }
    } catch (e) {
        console.error('[ThreeScene] dispose error:', e);
    }
    scene = null;
    camera = null;
    renderer = null;
    modelPivot = null;
    sparkParticles = null;
    headBone = null;
    bgMaterial = null;
    canvas = null;
}

function createSparkTexture() {
    const canvas2d = document.createElement('canvas');
    canvas2d.width = 64;
    canvas2d.height = 64;
    const ctx = canvas2d.getContext('2d');
    const gradient = ctx.createRadialGradient(32, 32, 0, 32, 32, 32);
    gradient.addColorStop(0, 'rgba(255, 255, 255, 1)');
    gradient.addColorStop(0.2, 'rgba(255, 255, 255, 0.8)');
    gradient.addColorStop(0.5, 'rgba(255, 255, 255, 0.3)');
    gradient.addColorStop(1, 'rgba(255, 255, 255, 0)');
    ctx.fillStyle = gradient;
    ctx.fillRect(0, 0, 64, 64);
    return new CanvasTexture(canvas2d);
}

function init() {
    canvas = document.querySelector('#webgl');
    if (!canvas) { console.error('[ThreeScene] Canvas not found'); return; }
    console.log('[ThreeScene] init() starting...');

    scene = new Scene();
    scene.background = new Color('#000000');
    scene.fog = new FogExp2('#000000', 0.01);

    camera = new PerspectiveCamera(50, sizes.width / sizes.height, 0.1, 100);
    camera.position.set(0, 0.2, 3.0);
    scene.add(camera);

    createBackgroundShader();

    renderer = new WebGLRenderer({ canvas, antialias: true, alpha: false, powerPreference: "high-performance" });
    renderer.setSize(sizes.width, sizes.height);
    renderer.setPixelRatio(getPixelRatio());
    renderer.shadowMap.enabled = true;
    renderer.shadowMap.type = PCFSoftShadowMap;
    renderer.toneMapping = ACESFilmicToneMapping;
    renderer.toneMappingExposure = 1.2;

    const ambientLight = new AmbientLight('#ffffff', 0.5);
    scene.add(ambientLight);

    const keyLight = new SpotLight('#eaf6ff', 90.0);
    keyLight.position.set(4, 6, 3);
    keyLight.angle = Math.PI / 4;
    keyLight.penumbra = 0.85;
    keyLight.castShadow = true;
    keyLight.shadow.mapSize.width = 2048;
    keyLight.shadow.mapSize.height = 2048;
    keyLight.shadow.camera.near = 1.0;
    keyLight.shadow.camera.far = 15;
    keyLight.shadow.bias = -0.001;
    scene.add(keyLight);

    const rimLight = new DirectionalLight('#c8b088', 5.0);
    rimLight.position.set(-5, 3, -4);
    scene.add(rimLight);

    const fillLight = new DirectionalLight('#66e0ff', 5.0);
    fillLight.position.set(-2, -4, 2);
    scene.add(fillLight);

    const hemiLight = new HemisphereLight('#8abae8', '#2a1a3e', 0.8);
    scene.add(hemiLight);

    createSparks();
    loadModel();
    console.log('[ThreeScene] init() complete.');
}

function createBackgroundShader() {
    const vertexShader = `
        varying vec2 vUv;
        void main() {
            vUv = uv;
            gl_Position = projectionMatrix * modelViewMatrix * vec4(position, 1.0);
        }
    `;

    const fragmentShader = `
        varying vec2 vUv;
        uniform float uTime;
        uniform vec2 uResolution;
        uniform vec2 uMouse;
        uniform float uScroll;

        float hash(float n) { return fract(sin(n) * 43758.5453123); }
        float noise(in vec3 x) {
            vec3 p = floor(x);
            vec3 f = fract(x);
            f = f*f*(3.0-2.0*f);
            float n = p.x + p.y*57.0 + 113.0*p.z;
            return mix(mix(mix(hash(n+  0.0), hash(n+  1.0), f.x),
                           mix(hash(n+ 57.0), hash(n+ 58.0), f.x), f.y),
                       mix(mix(hash(n+113.0), hash(n+114.0), f.x),
                           mix(hash(n+170.0), hash(n+171.0), f.x), f.y), f.z);
        }

        void main() {
            vec2 uv = (gl_FragCoord.xy - 0.5 * uResolution.xy) / uResolution.y;
            float aspect = uResolution.x / uResolution.y;
            float time = uTime * 0.08;
            float scroll = uScroll;

            float angle1 = 0.6;
            float angle2 = -0.7;
            float angle3 = 1.2;
            float freq1 = 2.4;
            float freq2 = 3.2;
            float freq3 = 4.0;

            vec2 warpedUv = uv;
            float scrollDeform = scroll * 5.0;
            warpedUv.x += sin(uv.y * 2.5 + time * 0.2 + scrollDeform) * 0.35;
            warpedUv.y += cos(uv.x * 2.5 - time * 0.15 - scrollDeform * 0.8) * 0.35;
            warpedUv.x += sin(uv.y * 1.2 - time * 0.1 - scrollDeform * 1.5) * 0.25;
            warpedUv.y += cos(uv.x * 1.2 + time * 0.18 + scrollDeform * 1.2) * 0.25;

            vec2 scrollDrift = vec2(scroll * 0.04, -scroll * 0.02);
            vec2 mouseShift = vec2(uMouse.x * aspect * 0.05, uMouse.y * 0.05);
            warpedUv += scrollDrift + mouseShift;

            vec2 dir1 = vec2(cos(angle1), sin(angle1));
            vec2 dir2 = vec2(cos(angle2), sin(angle2));
            vec2 dir3 = vec2(cos(angle3), sin(angle3));

            float w1 = sin(dot(warpedUv, dir1) * freq1 + time * 1.0);
            float w2 = cos(dot(warpedUv, dir2) * freq2 - time * 1.4 + w1 * 0.4);
            float w3 = sin(dot(warpedUv, dir3) * freq3 + time * 1.8 + w2 * 0.5);
            float waveField = w1 * 0.50 + w2 * 0.35 + w3 * 0.15;

            float wideSheen = pow(max(0.0, 1.0 - abs(waveField - 0.1)), 2.5);
            float crispSpecular = pow(max(0.0, 1.0 - abs(waveField - 0.15)), 8.0);
            float crest = wideSheen * 0.5 + crispSpecular * 0.9;

            vec3 c0_shadow = vec3(0.0004, 0.0006, 0.0012);
            vec3 c0_wave1  = vec3(0.010, 0.025, 0.055);
            vec3 c0_wave2  = vec3(0.005, 0.014, 0.035);
            vec3 c0_crest  = vec3(0.08, 0.22, 0.42);

            vec3 c1_shadow = vec3(0.0012, 0.0008, 0.0003);
            vec3 c1_wave1  = vec3(0.06, 0.045, 0.015);
            vec3 c1_wave2  = vec3(0.035, 0.025, 0.008);
            vec3 c1_crest  = vec3(0.35, 0.28, 0.10);

            float t = smoothstep(0.0, 1.0, scroll);
            vec3 colShadow = mix(c0_shadow, c1_shadow, t);
            vec3 colWave1  = mix(c0_wave1, c1_wave1, t);
            vec3 colWave2  = mix(c0_wave2, c1_wave2, t);
            vec3 colCrest  = mix(c0_crest, c1_crest, t);

            vec3 color = colShadow;
            color = mix(color, colWave2, smoothstep(-0.6, 0.2, waveField));
            color = mix(color, colWave1, smoothstep(0.0, 0.8, waveField));
            color += colCrest * crest * 1.0;

            float vignette = 1.0 - dot(uv, uv) * 0.12;
            color *= vignette;

            gl_FragColor = vec4(color, 1.0);
        }
    `;

    bgMaterial = new ShaderMaterial({
        vertexShader, fragmentShader, uniforms: shaderUniforms,
        depthWrite: false, depthTest: false
    });

    const bgGeometry = new PlaneGeometry(30, 30);
    const bgMesh = new Mesh(bgGeometry, bgMaterial);
    bgMesh.position.set(0.0, 0.0, -8.0);
    bgMesh.renderOrder = -10;
    camera.add(bgMesh);
}

function createSparks() {
    const geometry = new BufferGeometry();
    const positions = new Float32Array(sparkCount * 3);
    const colors = new Float32Array(sparkCount * 3);

    for (let i = 0; i < sparkCount; i++) {
        const x = (Math.random() - 0.5) * 6.5;
        const y = (Math.random() - 0.5) * 5.0 - 0.5;
        const z = (Math.random() - 0.5) * 6.5;
        positions[i * 3] = x;
        positions[i * 3 + 1] = y;
        positions[i * 3 + 2] = z;

        if (Math.random() < 0.6) {
            colors[i * 3] = 0.25 + Math.random() * 0.1;
            colors[i * 3 + 1] = 0.65 + Math.random() * 0.15;
            colors[i * 3 + 2] = 1.0;
        } else {
            colors[i * 3] = 0.85 + Math.random() * 0.15;
            colors[i * 3 + 1] = 0.35 + Math.random() * 0.1;
            colors[i * 3 + 2] = 1.0;
        }

        sparkData.push({
            speedX: (Math.random() - 0.5) * 0.4,
            speedY: 0.15 + Math.random() * 0.3,
            speedZ: (Math.random() - 0.5) * 0.4,
            swaySpeed: 0.5 + Math.random() * 1.5,
            swayRadius: 0.05 + Math.random() * 0.15,
            phase: Math.random() * Math.PI * 2
        });
    }

    geometry.setAttribute('position', new BufferAttribute(positions, 3));
    geometry.setAttribute('color', new BufferAttribute(colors, 3));

    const material = new PointsMaterial({
        size: 0.025, vertexColors: true, transparent: true, opacity: 0.85,
        blending: AdditiveBlending, depthWrite: false, map: createSparkTexture()
    });

    sparkParticles = new Points(geometry, material);
    scene.add(sparkParticles);
}

function createEnvMap() {
    const size = 256;
    const cubes = [];
    const colors = [
        { top: '#406880', mid: '#5888a0', bot: '#406880' },
        { top: '#406880', mid: '#6090a8', bot: '#406880' },
        { top: '#a08050', mid: '#b8a078', bot: '#a08050' },
        { top: '#406880', mid: '#508098', bot: '#406880' },
        { top: '#a08050', mid: '#b09870', bot: '#a08050' },
        { top: '#406880', mid: '#5888a0', bot: '#406880' },
    ];
    for (let face = 0; face < 6; face++) {
        const canvas = document.createElement('canvas');
        canvas.width = size; canvas.height = size;
        const ctx = canvas.getContext('2d');
        const c = colors[face];
        const grad = ctx.createLinearGradient(0, 0, 0, size);
        grad.addColorStop(0, c.top);
        grad.addColorStop(0.5, c.mid);
        grad.addColorStop(1, c.bot);
        ctx.fillStyle = grad;
        ctx.fillRect(0, 0, size, size);
        for (let i = 0; i < 8; i++) {
            const x = Math.random() * size;
            const y = Math.random() * size;
            const r = 2 + Math.random() * 6;
            const a = 0.02 + Math.random() * 0.04;
            ctx.beginPath();
            ctx.arc(x, y, r, 0, Math.PI * 2);
            ctx.fillStyle = `rgba(127, 216, 255, ${a})`;
            ctx.fill();
        }
        cubes.push(new CanvasTexture(canvas));
    }
    const cubeTexture = new CubeTexture(cubes);
    cubeTexture.needsUpdate = true;
    return cubeTexture;
}

function loadModel() {
    modelPivot = new Group();
    scene.add(modelPivot);

    const envMap = createEnvMap();
    scene.environment = envMap;

    const loader = new GLTFLoader();
    const dracoLoader = new DRACOLoader();
    dracoLoader.setDecoderPath('https://www.gstatic.com/draco/versioned/decoders/1.5.6/');
    loader.setDRACOLoader(dracoLoader);
    loader.load(
        '/compressed.glb',
        (gltf) => {
            const model = gltf.scene;
            modelPivot.add(model);

            model.traverse((child) => {
                if (child.isMesh) {
                    child.castShadow = true;
                    child.receiveShadow = true;
                    if (child.material) {
                        if (Array.isArray(child.material)) {
                            child.material.forEach(mat => {
                                mat.roughness = 0.05;
                                mat.metalness = 0.6;
                                mat.envMap = envMap;
                                mat.envMapIntensity = 6.0;
                            });
                        } else {
                            child.material.roughness = 0.2;
                            child.material.metalness = 0.9;
                            child.material.envMap = envMap;
                            child.material.envMapIntensity = 2.0;
                        }
                    }
                }
            });

            const box = new Box3().setFromObject(model);
            const size = box.getSize(new Vector3());
            const center = box.getCenter(new Vector3());
            const maxDim = Math.max(size.x, size.y, size.z);
            const scale = 2.8 / maxDim;
            model.scale.setScalar(scale);
            model.updateMatrixWorld(true);

            const box2 = new Box3().setFromObject(model);
            const center2 = box2.getCenter(new Vector3());
            model.position.sub(center2);

            modelPivot.position.y = -0.6;
            hideLoadingScreen();

            model.traverse((child) => {
                if (child.isBone && /head|neck/i.test(child.name)) {
                    headBone = child;
                }
            });
            if (!headBone) {
                model.traverse((child) => {
                    if (child.isMesh && /head|neck/i.test(child.name)) {
                        headBone = child;
                    }
                });
            }
        },
        (xhr) => {
            const loadingEl = document.getElementById('loading');
            if (loadingEl && xhr.total) {
                const pct = Math.round((xhr.loaded / xhr.total) * 100);
                loadingEl.textContent = 'Loading model... ' + pct + '%';
            }
        },
        (error) => {
            console.error('[ThreeScene] Model load error:', error);
            hideLoadingScreen();
        }
    );

    // ─── Ground Plane ───
    const groundGeo = new CircleGeometry(8, 64);
    const groundMat = new MeshPhysicalMaterial({
        color: 0x050810,
        roughness: 0.05,
        metalness: 0.0,
        transparent: true,
        opacity: 0,
        envMap: envMap,
        envMapIntensity: 0.3,
        side: DoubleSide,
    });
    const ground = new Mesh(groundGeo, groundMat);
    ground.rotation.x = -Math.PI / 2;
    ground.position.y = -2.5;
    ground.receiveShadow = true;
    scene.add(ground);

    const ringGeo = new RingGeometry(0.55, 0.65, 64);
    const ringMat = new MeshBasicMaterial({
        color: 0x7fd8ff,
        transparent: true,
        opacity: 0.08,
        side: DoubleSide,
        depthWrite: false,
    });
    const glowRing = new Mesh(ringGeo, ringMat);
    glowRing.rotation.x = -Math.PI / 2;
    glowRing.position.y = -1.3;
    scene.add(glowRing);

    const ringGeo2 = new RingGeometry(1.2, 1.4, 64);
    const ringMat2 = new MeshBasicMaterial({
        color: 0xc266ff,
        transparent: true,
        opacity: 0.06,
        side: DoubleSide,
        depthWrite: false,
    });
    const glowRing2 = new Mesh(ringGeo2, ringMat2);
    glowRing2.rotation.x = -Math.PI / 2;
    glowRing2.position.y = -1.34;
    scene.add(glowRing2);
}

function onWindowResize() {
    sizes.width = window.innerWidth;
    sizes.height = window.innerHeight;
    if (camera) {
        camera.aspect = sizes.width / sizes.height;
        camera.updateProjectionMatrix();
    }
    if (renderer) {
        renderer.setSize(sizes.width, sizes.height);
        renderer.setPixelRatio(getPixelRatio());
    }
    if (shaderUniforms) shaderUniforms.uResolution.value.set(sizes.width, sizes.height);
}

function splitTitlesIntoChars() {
    document.querySelectorAll('.slide-title').forEach(title => {
        if (title.querySelector('.char')) return; // Already split
        const text = title.innerHTML;
        const words = text.split(/<br[^>]*>/i);
        title.innerHTML = '';
        const decode = document.createElement('div');
        words.forEach((word, wi) => {
            if (wi > 0) title.appendChild(document.createElement('br'));
            decode.innerHTML = word;
            const decoded = decode.textContent;
            const wordSpan = document.createElement('span');
            wordSpan.style.display = 'inline-block';
            wordSpan.style.whiteSpace = 'pre';
            [...decoded].forEach(char => {
                const span = document.createElement('span');
                span.className = 'char';
                span.textContent = char === ' ' ? '\u00A0' : char;
                wordSpan.appendChild(span);
            });
            title.appendChild(wordSpan);
        });
    });
    console.log('[ThreeScene] splitTitlesIntoChars() done');
}

function updateSlides(scrollProgress) {
    const slides = document.querySelectorAll('.slide');
    const ranges = [
        [-0.10, 0.20],
        [0.20, 0.48],
        [0.48, 0.78],
        [0.78, 1.10]
    ];

    slides.forEach((slide, i) => {
        const [start, end] = ranges[i];
        const isActive = (i === currentSlide) || (scrollProgress >= start && scrollProgress < end);
        slide.classList.toggle('active', isActive);

        const chars = slide.querySelectorAll('.char');
        if (isActive) {
            chars.forEach((char, j) => {
                const delay = j * 0.035;
                char.style.transitionDelay = delay + 's';
                char.style.opacity = '1';
                char.style.transform = 'translateY(0)';
                char.style.filter = 'blur(0)';
            });
        } else {
            chars.forEach(char => {
                char.style.transitionDelay = '0s';
                char.style.opacity = '0';
                char.style.transform = 'translateY(50px)';
                char.style.filter = 'blur(12px)';
            });
        }
    });

    const imgMask = document.getElementById('slide-2-img');
    if (imgMask) {
        const isActive = (currentSlide === 1) || (scrollProgress >= 0.18 && scrollProgress < 0.50);
        imgMask.classList.toggle('active', isActive);
    }

    const dashFills = [
        document.getElementById('dash-fill-1'),
        document.getElementById('dash-fill-2'),
        document.getElementById('dash-fill-3'),
        document.getElementById('dash-fill-4')
    ];
    const dashRanges = [0.0, 0.25, 0.50, 0.75];
    const dashEnds = [0.22, 0.48, 0.72, 1.0];
    dashFills.forEach((dash, i) => {
        if (dash) {
            const progress = Math.max(0, Math.min(1, (scrollProgress - dashRanges[i]) / (dashEnds[i] - dashRanges[i])));
            dash.style.height = (progress * 100) + '%';
        }
    });
    document.querySelectorAll('.story-item').forEach((item, i) => {
        item.classList.toggle('active', i === currentSlide);
    });
}

function updateGridDots(scrollProgress) {
    const tops = document.querySelectorAll('.grid-dot.top');
    const bottoms = document.querySelectorAll('.grid-dot.bottom');
    tops.forEach((dot, i) => {
        const offset = (i + 1) * 0.1;
        const drift = Math.sin(scrollProgress * Math.PI * 4 + offset) * 15;
        const driftY = Math.cos(scrollProgress * Math.PI * 3 + offset * 2) * 8;
        dot.style.top = `calc(${15 + driftY + drift * 0.5}%)`;
    });
    bottoms.forEach((dot, i) => {
        const offset = (i + 1) * 0.15;
        const drift = Math.cos(scrollProgress * Math.PI * 3.5 + offset) * 12;
        const driftY = Math.sin(scrollProgress * Math.PI * 2.5 + offset * 1.5) * 10;
        dot.style.top = `calc(${85 + driftY + drift * 0.3}%)`;
    });
}

function animate() {
    if (disposed) return;
    rafId = requestAnimationFrame(animate);

    const delta = clock.getDelta();
    const time = clock.getElapsedTime();

    const targetScroll = slideTargets[currentSlide];
    currentScroll += (targetScroll - currentScroll) * 0.045;
    if (blockScroll && Math.abs(currentScroll - slideTargets[currentSlide]) <= 0.02) {
        blockScroll = false;
    }
    const scrollClamped = Math.max(0, Math.min(1, currentScroll));

    if (shaderUniforms) {
        shaderUniforms.uTime.value = time;
        shaderUniforms.uScroll.value = scrollClamped;
    }

    mouseX += (targetMouseX - mouseX) * 0.05;
    mouseY += (targetMouseY - mouseY) * 0.05;
    if (shaderUniforms) shaderUniforms.uMouse.value.set(mouseX, mouseY);

    if (camera) {
        const phi = scrollClamped * Math.PI * 2;
        const radius = 4.2 - Math.sin(scrollClamped * Math.PI) * 0.6;
        const y = 0.35 + Math.sin(scrollClamped * Math.PI) * 0.8;

        const easeFactor = Math.min(scrollClamped / 0.28, 1);
        const lookAtXOffset = -0.9 * easeFactor;

        const targetCamPos = new Vector3(
            Math.sin(phi) * radius,
            y,
            Math.cos(phi) * radius
        );
        camera.position.lerp(targetCamPos, 0.025);
        camera.lookAt(lookAtXOffset, -0.15, 0);
    }

    if (modelPivot) {
        modelPivot.rotation.y = mouseX * 0.25;
        modelPivot.rotation.x = mouseY * 0.15;
        modelPivot.position.y = -0.3 + Math.sin(time * 0.5) * 0.015;
        modelPivot.rotation.z = Math.sin(time * 0.3) * 0.002;

        if (headBone) {
            const headPos = new Vector3();
            headBone.getWorldPosition(headPos);
            const target = new Vector3(
                mouseX * 3,
                mouseY * 2 + 0.5,
                headPos.z + 2
            );
            const quatTarget = new Quaternion();
            const up = new Vector3(0, 1, 0);
            const matrix = new Matrix4().lookAt(headPos, target, up);
            quatTarget.setFromRotationMatrix(matrix);
            headBone.quaternion.slerp(quatTarget, 0.08);
        }
    }

    if (sparkParticles) {
        const positions = sparkParticles.geometry.attributes.position.array;
        const turbulence = scrollClamped * 1.5;
        for (let i = 0; i < sparkCount; i++) {
            const data = sparkData[i];
            if (!data) continue;
            const i3 = i * 3;
            positions[i3] += data.speedX * delta * (1 + turbulence * 0.15) + Math.sin(time * data.swaySpeed + i * 0.1 + data.phase) * data.swayRadius * delta * 2;
            positions[i3 + 1] += data.speedY * delta * (1 + turbulence * 0.2);
            positions[i3 + 2] += data.speedZ * delta * (1 + turbulence * 0.15) + Math.cos(time * data.swaySpeed + i * 0.1 + data.phase) * data.swayRadius * delta * 2;

            if (positions[i3 + 1] > 3.0 || Math.abs(positions[i3]) > 3.5 || Math.abs(positions[i3 + 2]) > 3.5) {
                positions[i3] = (Math.random() - 0.5) * 3.0;
                positions[i3 + 1] = -2.5;
                positions[i3 + 2] = (Math.random() - 0.5) * 3.0;
            }
        }
        sparkParticles.geometry.attributes.position.needsUpdate = true;
    }

    if (renderer && scene) {
        renderer.render(scene, camera);
    }

    updateSlides(scrollClamped);
    updateGridDots(scrollClamped);
}

// ─── Navigation / Modal ───
let lastFocusedElement = null;

function openModalByIdx(key) {
    const modal = document.getElementById('modal');
    const menu = document.getElementById('mobile-menu');
    const hamburger = document.getElementById('hamburger');
    if (menu && hamburger) {
        menu.classList.remove('active');
        hamburger.classList.remove('active');
        hamburger.setAttribute('aria-expanded', 'false');
    }
    let preset = null;
    if (/^\d+$/.test(String(key))) {
        preset = document.querySelectorAll('.modal-preset')[parseInt(key, 10)] || null;
    } else {
        preset = document.getElementById('preset-' + key);
    }
    if (modal && preset) {
        lastFocusedElement = document.activeElement;
        modal.querySelector('#modal-tag').textContent = preset.dataset.tag || '';
        modal.querySelector('#modal-title').innerHTML = preset.dataset.title || '';
        modal.querySelector('#modal-desc').innerHTML = preset.innerHTML;
        modal.querySelector('#modal-meta').textContent = preset.dataset.meta || '';
        modal.classList.add('active');
        modal.setAttribute('aria-hidden', 'false');
        const closeBtn = modal.querySelector('#modal-close');
        if (closeBtn) closeBtn.focus();
    }
}

function closeModal() {
    const modal = document.getElementById('modal');
    if (modal) {
        modal.classList.remove('active');
        modal.setAttribute('aria-hidden', 'true');
        if (lastFocusedElement && typeof lastFocusedElement.focus === 'function') {
            lastFocusedElement.focus();
        }
    }
}

// ─── Event listeners ───
window.addEventListener('resize', onWindowResize);

document.addEventListener('mousemove', (e) => {
    cursorX = e.clientX;
    cursorY = e.clientY;
    targetMouseX = (e.clientX / window.innerWidth) * 2 - 1;
    targetMouseY = -(e.clientY / window.innerHeight) * 2 + 1;
});

document.addEventListener('mouseleave', () => {
    targetMouseX = 0;
    targetMouseY = 0;
});

// Event delegation for nav links, contact buttons, story items, modal close, and mobile menu close
document.addEventListener('click', (e) => {
    const link = e.target.closest('.nav-link, .contact-btn');
    if (link) {
        const modalKey = link.dataset.modal;
        if (modalKey !== undefined) {
            e.preventDefault();
            e.stopPropagation();
            closeModal();
            openModalByIdx(modalKey);
        }
        const hamburger = document.getElementById('hamburger');
        const menu = document.getElementById('mobile-menu');
        if (hamburger && menu) {
            hamburger.classList.remove('active');
            menu.classList.remove('active');
            hamburger.setAttribute('aria-expanded', 'false');
        }
    }

    const storyItem = e.target.closest('.story-item');
    if (storyItem) {
        e.preventDefault();
        const slideIdx = parseInt(storyItem.dataset.slide, 10);
        if (!isNaN(slideIdx)) {
            currentSlide = slideIdx;
            setBlockScroll();
        }
    }

    const modal = document.getElementById('modal');
    if (modal) {
        if (e.target.id === 'modal-close' || e.target === modal || (e.target.classList && e.target.classList.contains('modal-bg'))) {
            closeModal();
        }
    }
}, true);

// Keyboard: Escape closes modal; arrows navigate slides
document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape') closeModal();
    if (isOverlayActive()) return;
    if (e.key === 'ArrowDown' || e.key === 'ArrowRight') {
        if (blockScroll) return;
        if (currentSlide < slideTargets.length - 1) {
            e.preventDefault();
            currentSlide++;
            setBlockScroll();
        }
    } else if (e.key === 'ArrowUp' || e.key === 'ArrowLeft') {
        if (blockScroll) return;
        if (currentSlide > 0) {
            e.preventDefault();
            currentSlide--;
            setBlockScroll();
        }
    }
});

function isOverlayActive() {
    const modal = document.getElementById('modal');
    const menu = document.getElementById('mobile-menu');
    return (modal && modal.classList.contains('active')) || (menu && menu.classList.contains('active'));
}

let blockScrollTimer = null;
function setBlockScroll() {
    blockScroll = true;
    if (blockScrollTimer) clearTimeout(blockScrollTimer);
    blockScrollTimer = setTimeout(() => {
        blockScroll = false;
    }, 1200);
}

// Wheel navigation
document.addEventListener('wheel', (e) => {
    if (isOverlayActive()) return;
    if (blockScroll) return;
    if (e.deltaY > 0 && currentSlide < slideTargets.length - 1) {
        currentSlide++;
        setBlockScroll();
    } else if (e.deltaY < 0 && currentSlide > 0) {
        currentSlide--;
        setBlockScroll();
    }
}, { passive: true });

// Swipe support
let touchStartY = 0;
let touchStartX = 0;
document.addEventListener('touchstart', (e) => {
    touchStartY = e.changedTouches[0].screenY;
    touchStartX = e.changedTouches[0].screenX;
}, { passive: true });

document.addEventListener('touchend', (e) => {
    if (isOverlayActive()) return;
    const dy = touchStartY - e.changedTouches[0].screenY;
    const dx = touchStartX - e.changedTouches[0].screenX;
    if (Math.abs(dy) > 40 && Math.abs(dy) > Math.abs(dx)) {
        if (blockScroll) return;
        if (dy > 0 && currentSlide < slideTargets.length - 1) {
            currentSlide++;
            setBlockScroll();
        } else if (dy < 0 && currentSlide > 0) {
            currentSlide--;
            setBlockScroll();
        }
    }
}, { passive: true });

function hideLoadingScreen() {
    const loadingEl = document.getElementById('loading');
    if (loadingEl && loadingEl.style.display !== 'none') {
        loadingEl.style.opacity = '0';
        setTimeout(() => {
            loadingEl.style.display = 'none';
            loadingEl.setAttribute('aria-hidden', 'true');
        }, 400);
    }
}

// ─── Start everything ───
function start() {
    const webglCanvas = document.querySelector('#webgl');
    if (!webglCanvas) return;
    if (started) return;
    started = true;
    disposed = false;

    console.log('[ThreeScene] start() called');

    currentScroll = 0;
    currentSlide = 0;
    blockScroll = false;
    mouseX = 0;
    mouseY = 0;
    targetMouseX = 0;
    targetMouseY = 0;

    if (shaderUniforms) {
        shaderUniforms.uTime.value = 0;
        shaderUniforms.uScroll.value = 0;
        shaderUniforms.uMouse.value.set(0, 0);
        shaderUniforms.uResolution.value.set(window.innerWidth, window.innerHeight);
    }

    splitTitlesIntoChars();

    const initTask = () => {
        try {
            init();
            onWindowResize();
        } catch (e) {
            console.error('[ThreeScene] 3D init failed — slides will still work:', e);
            hideLoadingScreen();
        }
    };
    if ('requestIdleCallback' in window) {
        window.requestIdleCallback(initTask, { timeout: 2000 });
    } else {
        setTimeout(initTask, 100);
    }

    // Guaranteed safety timeout: hide loading overlay within 1.2s regardless of 3D load state
    setTimeout(hideLoadingScreen, 1200);

    animate();
    console.log('[ThreeScene] animate() started — scroll slider active');
}

function checkUrlModal() {
    const urlParams = new URLSearchParams(window.location.search);
    const modalKey = urlParams.get('modal');
    if (modalKey !== null) {
        setTimeout(() => {
            openModalByIdx(modalKey);
        }, 1600);
    }
}

if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', () => {
        start();
        checkUrlModal();
    });
} else {
    start();
    checkUrlModal();
}

document.addEventListener('astro:page-load', () => {
    start();
    checkUrlModal();
});

// Dispose WebGL resources before a View Transition swaps the page
document.addEventListener('astro:before-swap', disposeThree);
</script>